<?xml version="1.0" encoding="UTF-8"?>
<configuration>
<!-- Drops UT005028 ClosedChannelException noise (upstream idle-close / stale pool); real proxy errors still logged -->
<turboFilter class="io.surisoft.capi.utils.UndertowProxyNoiseFilter"/>
<!-- Camel noise control -->
<logger name="org.apache.camel" level="INFO"/>
<logger name="org.apache.camel.impl.engine" level="WARN"/>
<logger name="org.apache.camel.component" level="INFO"/>
<logger name="org.apache.camel.main" level="INFO"/>
<!-- Undertow -->
<logger name="io.undertow" level="WARN"/>
<!-- Kafka -->
<logger name="org.apache.kafka" level="WARN"/>
<!-- OpenTelemetry -->
<logger name="io.opentelemetry" level="WARN"/>
<logger name="io.swagger.v3" level="error"/>
<!-- CAPI -->
<logger name="io.surisoft.capi" level="INFO"/>

<!-- CAPI Logs properties -->
<property name="logsEnabled"
                value="${logging.logback.logs.enabled}" />
<property name="logsTenant"
                value="${logging.logback.logs.tenant}"/>
<property name="logsAppName"
                value="${logging.logback.logs.appName}"/>
<property name="logsAppEnvironment"
                value="${logging.logback.logs.appEnvironment}"/>
<property name="logsDestination"
                value="${logging.logback.logs.destination}"/>

<!-- Access Logs properties -->
<property name="accessLogsEnabled"
                value="${logging.logback.access.enabled}" />
<property name="accessLogsTenant"
                value="${logging.logback.access.tenant}"/>
<property name="accessLogsService"
                value="${logging.logback.access.service}"/>
<property name="accessLogsDestination"
                value="${logging.logback.access.destination}"/>

<!-- File logging properties -->
<property name="logsFileEnabled"
                value="${logging.logback.logs.fileEnabled}" />
<property name="logsFilePath"
                value="${logging.logback.logs.filePath}"/>
<property name="accessFileEnabled"
                value="${logging.logback.access.fileEnabled}" />
<property name="accessLogsFilePath"
                value="${logging.logback.access.filePath}"/>

<property name="logstashDestination" value="${logstash-destination}"/>

<!-- OpenTelemetry MDC instrumentation: auto-injects trace_id and span_id into MDC -->
<appender name="OTEL" class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender">
    <appender-ref ref="CONSOLE"/>
</appender>

<!-- Pattern with trace/span support -->
<property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

<!-- Console appender -->
<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
        <pattern>${LOG_PATTERN}</pattern>
    </encoder>
</appender>

<!-- LOGSTASH appender (only created when logs are enabled) -->
<condition class="ch.qos.logback.core.boolex.PropertyEqualityCondition">
    <key>logsEnabled</key>
    <value>true</value>
</condition>
<if>
    <then>
        <appender name="LOGSTASH" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
            <destination>${logsDestination}</destination>
            <keepAliveDuration>5 minutes</keepAliveDuration>
            <connectionTimeout>5s</connectionTimeout>
            <writeTimeout>5s</writeTimeout>
            <reconnectionDelay>10s</reconnectionDelay>
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>
                    {
                    "tenant":"${logsTenant}",
                    "appName":"${logsAppName}",
                    "appEnvironment":"${logsAppEnvironment}",
                    "host":"${accessLogsDestination}"
                    }
                </customFields>
                <includeMdc>true</includeMdc>
                <includeContext>true</includeContext>
                <includeStructuredArguments>true</includeStructuredArguments>
            </encoder>
        </appender>
    </then>
</if>

<!-- App logs rolling file appender (only created when filePath is configured) -->
<condition class="ch.qos.logback.core.boolex.PropertyEqualityCondition">
    <key>logsFileEnabled</key>
    <value>true</value>
</condition>
<if>
    <then>
        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${logsFilePath}</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${logsFilePath}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
                <maxFileSize>100MB</maxFileSize>
                <maxHistory>30</maxHistory>
                <totalSizeCap>3GB</totalSizeCap>
            </rollingPolicy>
            <encoder>
                <pattern>${LOG_PATTERN}</pattern>
            </encoder>
        </appender>
    </then>
</if>

<!-- ACCESS-LOGSTASH appender (only created when access logs are enabled) -->
<condition class="ch.qos.logback.core.boolex.PropertyEqualityCondition">
    <key>accessLogsEnabled</key>
    <value>true</value>
</condition>
<if>
    <then>
        <appender name="ACCESS-LOGSTASH"
                  class="net.logstash.logback.appender.LogstashTcpSocketAppender">
            <destination>${accessLogsDestination}</destination>
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>
                    {
                    "log_type":"access",
                    "service":"${accessLogsService}",
                    "tenant": "${accessLogsTenant}"
                    }
                </customFields>
            </encoder>
        </appender>
        <appender name="ASYNC-ACCESS" class="ch.qos.logback.classic.AsyncAppender">
            <queueSize>16384</queueSize>
            <neverBlock>true</neverBlock>
            <appender-ref ref="ACCESS-LOGSTASH"/>
        </appender>
    </then>
</if>

<!-- Access logs rolling file appender (only created when filePath is configured) -->
<condition class="ch.qos.logback.core.boolex.PropertyEqualityCondition">
    <key>accessFileEnabled</key>
    <value>true</value>
</condition>
<if>
    <then>
        <appender name="ACCESS-FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${accessLogsFilePath}</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${accessLogsFilePath}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
                <maxFileSize>100MB</maxFileSize>
                <maxHistory>30</maxHistory>
                <totalSizeCap>3GB</totalSizeCap>
            </rollingPolicy>
            <encoder>
                <pattern>%msg%n</pattern>
            </encoder>
        </appender>
    </then>
</if>

<!-- Root logger: app logs to console + logstash + file -->
<root level="INFO">
    <appender-ref ref="OTEL"/>
    <appender-ref ref="LOGSTASH"/>
    <appender-ref ref="FILE"/>
</root>

<!-- Access logger: separate from root, only to access-specific appenders -->
<condition class="ch.qos.logback.core.boolex.PropertyEqualityCondition">
    <key>accessLogsEnabled</key>
    <value>true</value>
</condition>
<if>
    <then>
        <logger name="capi.access" level="INFO" additivity="false">
            <appender-ref ref="ASYNC-ACCESS"/>
            <appender-ref ref="ACCESS-FILE"/>
        </logger>
    </then>
</if>
</configuration>
