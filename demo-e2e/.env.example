# Copy to .env and fill in values before running docker compose up
# cp .env.example .env

# Keycloak admin
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=changeme

# Keycloak demo users
ALICE_PASSWORD=changeme
BOB_PASSWORD=changeme
CHARLIE_PASSWORD=changeme

# Keycloak client secrets
BFF_CLIENT_SECRET=changeme
PREMIUM_CLIENT_SECRET=changeme
BASIC_CLIENT_SECRET=changeme

# OpenSearch
OPENSEARCH_PASSWORD=changeme

# API Keys (plain-text values that get SHA-256 hashed at setup time)
API_KEY_UNLIMITED=changeme
API_KEY_STANDARD=changeme
API_KEY_LIMITED=changeme

# Flask BFF session secret
BFF_SESSION_SECRET=changeme

# External URL (no trailing slash)
EXTERNAL_URL=http://localhost

# SSL / Nginx
SSL_DOMAIN=capigateway.eu
CERTBOT_DIR=./certbot